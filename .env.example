# ==============================================================================
# 智投内参 (xueqiusub) 环境变量配置文件示例
# 复制此文件为 .env 并根据实际情况填写配置：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础系统配置
# ------------------------------------------------------------------------------
# 平台展示名称
APP_NAME=智投内参
# 系统时区
APP_TIMEZONE=Asia/Shanghai
# 网站对外访问公网基地址（用于邮件与通知中的链接跳转，例如 http://your-domain.com:8100）
BASE_URL=http://localhost:8100
# SQLite 数据库存储路径（容器内路径）
DATABASE_URL=sqlite:///./data/xueqiu.db
# 应用安全密钥（用于 JWT Token 与密码哈希签名，请使用 openssl rand -hex 32 随机生成）
SECRET_KEY=change_this_to_a_random_secure_secret_key_string

# 初始管理员账号（容器初次启动时将自动创建）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# ------------------------------------------------------------------------------
# 2. RSSHub 数据抓取服务配置
# ------------------------------------------------------------------------------
# 内部 RSSHub 服务通信地址
RSSHUB_BASE_URL=http://rsshub:1200
# 雪球用户动态路由前缀
RSSHUB_XUEQIU_PATH=/xueqiu/user
# 后台轮询抓取时间间隔（秒，默认 600 秒 = 10分钟）
POLL_INTERVAL_SECONDS=600
# 单次网络请求超时时间（秒）
HTTP_TIMEOUT_SECONDS=30
# 单次抓取最大条数限制
FETCH_LIMIT=50

# ------------------------------------------------------------------------------
# 3. AI 大模型配置 (LLM / 智能投研内参生成)
# ------------------------------------------------------------------------------
# 是否开启 AI 投研内参自动生成与摘要功能
LLM_ENABLED=true
# OpenAI 兼容 API 基地址 (支持 DeepSeek, Qwen, Moonshot, SiliconFlow, OpenAI 等)
LLM_API_BASE=https://api.openai.com/v1
# 大模型 API Key
LLM_API_KEY=your_llm_api_key_here
# 模型名称 (如 gpt-4o-mini, deepseek-chat, qwen-plus 等)
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. 邮件通知配置 (SMTP / 每日投研内参报告与即时预警)
# ------------------------------------------------------------------------------
# 发信服务器地址 (例如 smtp.qq.com, smtp.163.com, smtp.feishu.cn 等)
SMTP_HOST=smtp.example.com
# 发信服务器端口 (SSL 常用 465, STARTTLS 常用 587)
SMTP_PORT=465
# 发信邮箱账号
SMTP_USERNAME=your_email@example.com
# 发信邮箱密码或客户端授权码 (如 QQ 邮箱 POP3/SMTP 授权码)
SMTP_PASSWORD=your_smtp_authorization_code
# 发件人显示信息
SMTP_FROM="智投内参 <your_email@example.com>"
# 是否启用 SSL 加密 (端口为 465 时设为 true)
SMTP_SSL=true
# 是否启用 STARTTLS 加密 (端口为 587 时设为 true)
SMTP_STARTTLS=false

# 每日定时汇总邮件发送时间 (24小时制小时数，如 21 代表每晚 21:00 发送)
DIGEST_HOUR=21
# 发送失败最大重试次数
DELIVERY_MAX_ATTEMPTS=3
# 重试等待基础时长（秒）
RETRY_BASE_SECONDS=60
